# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/roadside_logistics

# JWT Security Secrets (Generate using openssl rand -hex 32)
JWT_SECRET_KEY=replace_with_a_secure_random_secret_key_minimum_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS & Frontend Origin
FRONTEND_ORIGIN=http://localhost:5173
ENVIRONMENT=development
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
